<Window x:Class="PhotoShelf.Desktop.SimilarPhotoReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PhotoShelf.Desktop"
        Title="Похожие фотографии"
        Width="1280" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#FFF7F4EF"
        Icon="pack://application:,,,/PhotoShelf;component/Assets/PhotoShelf.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="18" BorderBrush="#FFE6DDD2" BorderThickness="1" Padding="18,14">
            <StackPanel>
                <TextBlock Text="Похожие фотографии" FontSize="22" FontWeight="SemiBold" Foreground="#FF242424" />
                <TextBlock x:Name="SummaryText" Margin="0,4,0,0" Foreground="#FF77706A" />
                <TextBlock Margin="0,7,0,0" MaxWidth="900" HorizontalAlignment="Left" TextWrapping="Wrap"
                           Foreground="#FF9A9289" FontSize="12"
                           Text="PhotoShelf сравнивает внешний вид, а не содержимое файла. Это могут быть кадры одной серии, уменьшенные копии или просто похожие изображения. Решение всегда остаётся за вами." />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="18" BorderBrush="#FFE6DDD2" BorderThickness="1" Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="4,8,4,4">
                        <TextBlock x:Name="GroupsPageText" HorizontalAlignment="Center" Foreground="#FF77706A" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="PreviousGroupsButton" Content="← Группы" Click="OnPreviousGroupsClicked" Margin="2" Padding="8,4" />
                            <Button x:Name="NextGroupsButton" Content="Группы →" Click="OnNextGroupsClicked" Margin="2" Padding="8,4" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Серии" FontSize="15" FontWeight="SemiBold" Margin="8,4,8,8" />
                    <ListBox x:Name="GroupList" ItemsSource="{Binding Groups}"
                             SelectionChanged="OnGroupSelectionChanged" BorderThickness="0" Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SimilarPhotoGroupViewModel}">
                                <Border Margin="4" Padding="12" Background="#FFFBFAF7" BorderBrush="#FFE9E1D8" BorderThickness="1" CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding ReferenceFolder}" Foreground="#FF77706A" TextTrimming="CharacterEllipsis" FontSize="11" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding DistanceSummary}" Foreground="#FFB65F35" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="18" BorderBrush="#FFE6DDD2" BorderThickness="1" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="4,0,4,10">
                        <TextBlock Text="Кадры в выбранной серии" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Первый кадр — стабильный эталон, с которым сравнены остальные." Margin="0,3,0,0" FontSize="11" Foreground="#FF77706A" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="4,8,4,4">
                        <TextBlock x:Name="MembersPageText" HorizontalAlignment="Center" Foreground="#FF77706A" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="PreviousMembersButton" Content="← Фото" Click="OnPreviousMembersClicked" Margin="2" Padding="8,4" />
                            <Button x:Name="NextMembersButton" Content="Фото →" Click="OnNextMembersClicked" Margin="2" Padding="8,4" />
                        </StackPanel>
                    </StackPanel>
                    <ListBox x:Name="ItemList" ItemsSource="{Binding SelectedGroup.Items}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SimilarPhotoItemViewModel}">
                                <Border Width="230" Height="260" Padding="9" Background="#FFFBFAF7"
                                        BorderBrush="#FFE9E1D8" BorderThickness="1" CornerRadius="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="158" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="#FFECE5DC" CornerRadius="10" ClipToBounds="True">
                                            <Image local:AsyncMediaImage.Path="{Binding Photo.Path}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="2,8,2,0">
                                            <TextBlock Text="{Binding Photo.FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0" Text="{Binding Photo.DetailLine}" FontSize="11" Foreground="#FF77706A" />
                                            <TextBlock Margin="0,3,0,0" Text="{Binding SimilarityText}" FontSize="11" Foreground="#FFB65F35" />
                                        </StackPanel>
                                        <Button Grid.Row="2" Content="Показать в папке" Tag="{Binding Photo.Path}"
                                                Click="OnShowInFolderClicked" Padding="8,4" HorizontalAlignment="Left" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FF2F3136" CornerRadius="18" Padding="14,8">
            <Grid>
                <TextBlock x:Name="StatusText" Foreground="#FFEFEFEF" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="760" />
                <Button HorizontalAlignment="Right" Style="{StaticResource DarkPillButton}" Content="Закрыть" Click="OnCloseClicked" />
            </Grid>
        </Border>
    </Grid>
</Window>
