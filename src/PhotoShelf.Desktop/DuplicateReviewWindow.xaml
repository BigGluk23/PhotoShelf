<Window x:Class="PhotoShelf.Desktop.DuplicateReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PhotoShelf.Desktop"
        Title="Разбор дубликатов"
        Width="1240"
        Height="780"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#FFF7F4EF"
        Icon="Assets/PhotoShelf.ico">
    <Window.Resources>
        <local:BooleanNotConverter x:Key="BooleanNot" />
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="126" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <Border Background="#FFFFFFFF" CornerRadius="18" BorderBrush="#FFE6DDD2" BorderThickness="1" Padding="18,12">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Точные дубликаты" FontSize="22" FontWeight="SemiBold" Foreground="#FF242424" />
                    <TextBlock x:Name="SummaryText" Margin="0,4,0,0" Foreground="#FF77706A" />
                    <TextBlock Margin="0,6,18,0"
                               Text="Группа — это несколько файлов с одинаковым содержимым. Выберите одну копию оставить, остальные можно перенести в карантин."
                               Foreground="#FF9A9289"
                               FontSize="12"
                               TextWrapping="Wrap"
                               MaxWidth="760" />
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryPillButton}" Content="Оставить новые" Click="OnKeepNewestClicked" />
                    <Button Margin="8,0,0,0" Style="{StaticResource PillButton}" Content="Оставить ближе к корню" ToolTip="Оставляет копию, которая лежит в более коротком и обычно более понятном пути, например D:\Фото вместо D:\Фото\Копии\Старое\..." Click="OnKeepShortestPathClicked" />
                    <Button Margin="8,0,0,0" Style="{StaticResource PillButton}" Content="Оставить крупный файл" Click="OnKeepLargestFileClicked" />
                    <Button Margin="8,0,0,0" Style="{StaticResource PillButton}" Content="Отметить лишние" Click="OnMarkExtrasClicked" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#FFFFFFFF" CornerRadius="18" BorderBrush="#FFE6DDD2" BorderThickness="1" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Группы" FontSize="15" FontWeight="SemiBold" Margin="8,4,8,8" Foreground="#FF242424" />
                    <ListBox x:Name="GroupList"
                             ItemsSource="{Binding Groups}"
                             SelectionChanged="OnGroupSelectionChanged"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:DuplicateGroupViewModel}">
                                <Border Margin="4" Padding="12" Background="#FFFBFAF7" BorderBrush="#FFE9E1D8" BorderThickness="1" CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding KeepPath}" Foreground="#FF77706A" TextTrimming="CharacterEllipsis" FontSize="11" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding MoveCount, StringFormat=Отмечено в карантин: {0}}" Foreground="#FFB65F35" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="#FFFFFFFF" CornerRadius="18" BorderBrush="#FFE6DDD2" BorderThickness="1" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Файлы в выбранной группе"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="4,0,4,10"
                               Foreground="#FF242424" />
                    <ListBox x:Name="ItemList"
                             ItemsSource="{Binding SelectedGroup.Items}"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:DuplicateItemViewModel}">
                                <Border Margin="4,5" Padding="10" Background="#FFFBFAF7" BorderBrush="#FFE9E1D8" BorderThickness="1" CornerRadius="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="104" Height="76" Background="#FFECE5DC" CornerRadius="10" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Photo.Thumbnail}" Stretch="UniformToFill" />
                                                <TextBlock Text="{Binding Photo.KindLabel}" Foreground="#FF77706A" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Photo.FileName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding Photo.DetailLine}" Foreground="#FF77706A" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding Photo.Folder}" Foreground="#FF77706A" TextTrimming="CharacterEllipsis" FontSize="11" />
                                            <TextBlock Margin="0,5,0,0" Text="{Binding RoleText}" Foreground="#FFB65F35" FontSize="11" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <RadioButton Content="Оставить"
                                                         IsChecked="{Binding IsKeep, Mode=OneWay}"
                                                         GroupName="KeepInGroup"
                                                         Click="OnKeepItemClicked" />
                                            <CheckBox Margin="16,0,0,0"
                                                      Content="В карантин"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsKeep, Converter={StaticResource BooleanNot}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FF2F3136" CornerRadius="18" Padding="14,8">
            <Grid>
                <TextBlock x:Name="StatusText" Foreground="#FFEFEFEF" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource DarkPillButton}" Content="Открыть карантин" Click="OnOpenQuarantineClicked" />
                    <Button Margin="8,0,0,0" Style="{StaticResource DangerPillButton}" Content="Перенести отмеченные" Click="OnMoveMarkedClicked" />
                    <Button Margin="8,0,0,0" Style="{StaticResource DarkPillButton}" Content="Закрыть" Click="OnCloseClicked" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
