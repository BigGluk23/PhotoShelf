<Window x:Class="PhotoShelf.Desktop.PhotoCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сравнение копий"
        Width="1180"
        Height="780"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#FF17191E"
        Foreground="#FFF4F4F4"
        KeyDown="OnWindowKeyDown"
        Icon="pack://application:,,,/PhotoShelf;component/Assets/PhotoShelf.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#FF23262C" Padding="18,12" BorderBrush="#FF393D45" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Общий масштаб" VerticalAlignment="Center" Foreground="#FFCACDD3" />
                    <Slider x:Name="ZoomSlider"
                            Width="190"
                            Margin="12,0,8,0"
                            Minimum="0.25"
                            Maximum="4"
                            Value="1"
                            SmallChange="0.05"
                            LargeChange="0.25"
                            ValueChanged="OnZoomChanged" />
                    <TextBlock x:Name="ZoomText" Width="48" VerticalAlignment="Center" Text="100%" />
                    <Button Margin="8,0,0,0" Padding="14,6" Content="Вписать" Click="OnResetClicked" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Сравнение копий" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,0,0"
                               Text="Масштаб и перемещение синхронны во всех окнах"
                               Foreground="#FFAEB3BC" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="ComparisonGrid" Grid.Row="1" Margin="10" />

        <Border Grid.Row="2" Background="#FF23262C" Padding="16,9" BorderBrush="#FF393D45" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       Foreground="#FFC9CDD4"
                       Text="Колесо мыши — масштаб · перетаскивание — панорама · R — вписать · Esc — закрыть" />
        </Border>
    </Grid>
</Window>
