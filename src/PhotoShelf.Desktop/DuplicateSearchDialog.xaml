<Window x:Class="PhotoShelf.Desktop.DuplicateSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поиск повторов"
        Width="680"
        Height="680"
        MinWidth="560"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#FFF7F4EF"
        Icon="pack://application:,,,/PhotoShelf;component/Assets/PhotoShelf.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Что будем искать?" FontSize="22" FontWeight="SemiBold" Foreground="#FF242424" />
            <TextBlock Margin="0,6,0,0"
                       Text="Точные дубли сравниваются по содержимому файла. Похожие фото ищутся по визуальному отпечатку и всегда требуют просмотра человеком."
                       TextWrapping="Wrap" Foreground="#FF77706A" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="14" BorderBrush="#FFE6DDD2" BorderThickness="1" Padding="14">
                <RadioButton x:Name="ExactModeRadio" GroupName="SearchMode" IsChecked="True" Checked="OnModeChanged">
                    <StackPanel>
                        <TextBlock Text="Точные дубли" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0" Text="Одинаковые байт в байт" FontSize="12" Foreground="#FF77706A" />
                    </StackPanel>
                </RadioButton>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="14" BorderBrush="#FFE6DDD2" BorderThickness="1" Padding="14">
                <RadioButton x:Name="SimilarModeRadio" GroupName="SearchMode" Checked="OnModeChanged">
                    <StackPanel>
                        <TextBlock Text="Похожие фото" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0" Text="Серии и визуально близкие кадры" FontSize="12" Foreground="#FF77706A" />
                    </StackPanel>
                </RadioButton>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,16,0,14" Background="White" CornerRadius="16"
                BorderBrush="#FFE6DDD2" BorderThickness="1" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="ScopeTitleText" Text="Где искать точные дубликаты?"
                               FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />
                    <RadioButton x:Name="CurrentViewRadio" Margin="0,0,0,12" IsChecked="True" GroupName="DuplicateScope">
                        <StackPanel>
                            <TextBlock Text="Текущий вид" FontWeight="SemiBold" />
                            <TextBlock x:Name="CurrentViewDescription" Margin="0,3,0,0" FontSize="12" Foreground="#FF77706A" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="IncludedFoldersRadio" Margin="0,0,0,12" GroupName="DuplicateScope">
                        <StackPanel>
                            <TextBlock Text="Папки, отмеченные галочками" FontWeight="SemiBold" />
                            <TextBlock x:Name="IncludedFoldersDescription" Margin="0,3,0,0" FontSize="12" Foreground="#FF77706A" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="CurrentFolderRadio" Margin="0,0,0,12" GroupName="DuplicateScope">
                        <StackPanel>
                            <TextBlock Text="Текущая папка" FontWeight="SemiBold" />
                            <TextBlock x:Name="CurrentFolderDescription" Margin="0,3,0,0" FontSize="12" Foreground="#FF77706A" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="CompareFoldersRadio" Margin="0,0,0,12" GroupName="DuplicateScope">
                        <StackPanel>
                            <TextBlock Text="Сравнить две папки" FontWeight="SemiBold" />
                            <TextBlock Margin="0,3,0,8" Text="Показать совпадения только между двумя выбранными папками."
                                       FontSize="12" Foreground="#FF77706A" TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderABox" Height="28" Margin="0,0,8,6" IsReadOnly="True" VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Width="80" Height="28" Margin="0,0,0,6" Content="Папка A" Click="OnBrowseFolderAClicked" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderBBox" Height="28" Margin="0,0,8,0" IsReadOnly="True" VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Width="80" Height="28" Content="Папка B" Click="OnBrowseFolderBClicked" />
                            </Grid>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="WholeLibraryRadio" GroupName="DuplicateScope">
                        <StackPanel>
                            <TextBlock Text="Вся библиотека" FontWeight="SemiBold" />
                            <TextBlock x:Name="WholeLibraryDescription" Margin="0,3,0,0" FontSize="12" Foreground="#FF77706A" TextWrapping="Wrap" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="SafetyText"
                       Text="Перемещение в карантин будет только после отдельного подтверждения."
                       Foreground="#FF77706A" Margin="0,0,16,0" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="110" Style="{StaticResource PillButton}" Content="Отмена" Click="OnCancelClicked" />
                <Button Width="120" Margin="8,0,0,0" Style="{StaticResource PrimaryPillButton}" Content="Начать" Click="OnStartClicked" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
