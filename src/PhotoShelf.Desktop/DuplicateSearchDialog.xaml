<Window x:Class="PhotoShelf.Desktop.DuplicateSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поиск дублей"
        Width="620"
        Height="560"
        MinWidth="500"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF7F4EF"
        Icon="Assets/PhotoShelf.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Где искать точные дубликаты?" FontSize="22" FontWeight="SemiBold" Foreground="#FF242424" />
            <TextBlock Margin="0,6,0,0"
                       Text="PhotoShelf сравнит содержимое файлов. Уже посчитанные хэши будут взяты из каталога, поэтому повторный поиск быстрее."
                       TextWrapping="Wrap"
                       Foreground="#FF77706A" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,14" Background="White" CornerRadius="16" BorderBrush="#FFE6DDD2" BorderThickness="1" Padding="16">
            <StackPanel>
                <RadioButton x:Name="CurrentViewRadio"
                             Margin="0,0,0,12"
                             IsChecked="True"
                             GroupName="DuplicateScope">
                    <StackPanel>
                        <TextBlock Text="Текущий вид" FontWeight="SemiBold" />
                        <TextBlock x:Name="CurrentViewDescription" Margin="0,3,0,0" FontSize="12" Foreground="#FF77706A" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="IncludedFoldersRadio"
                             Margin="0,0,0,12"
                             GroupName="DuplicateScope">
                    <StackPanel>
                        <TextBlock Text="Папки, отмеченные галками" FontWeight="SemiBold" />
                        <TextBlock x:Name="IncludedFoldersDescription" Margin="0,3,0,0" FontSize="12" Foreground="#FF77706A" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="CurrentFolderRadio"
                             Margin="0,0,0,12"
                             GroupName="DuplicateScope">
                    <StackPanel>
                        <TextBlock Text="Текущая папка" FontWeight="SemiBold" />
                        <TextBlock x:Name="CurrentFolderDescription" Margin="0,3,0,0" FontSize="12" Foreground="#FF77706A" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="CompareFoldersRadio"
                             Margin="0,0,0,12"
                             GroupName="DuplicateScope">
                    <StackPanel>
                        <TextBlock Text="Сравнить две папки" FontWeight="SemiBold" />
                        <TextBlock Margin="0,3,0,8" Text="Найти совпадения только между двумя выбранными папками." FontSize="12" Foreground="#FF77706A" TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderABox" Height="28" Margin="0,0,8,6" IsReadOnly="True" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Width="80" Height="28" Margin="0,0,0,6" Content="Папка A" Click="OnBrowseFolderAClicked" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderBBox" Height="28" Margin="0,0,8,0" IsReadOnly="True" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Width="80" Height="28" Content="Папка B" Click="OnBrowseFolderBClicked" />
                        </Grid>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="WholeLibraryRadio"
                             GroupName="DuplicateScope">
                    <StackPanel>
                        <TextBlock Text="Вся библиотека" FontWeight="SemiBold" />
                        <TextBlock x:Name="WholeLibraryDescription" Margin="0,3,0,0" FontSize="12" Foreground="#FF77706A" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Перемещение в карантин будет только после отдельного подтверждения."
                       Foreground="#FF77706A"
                       Margin="0,0,16,0"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="110" Style="{StaticResource PillButton}" Content="Отмена" Click="OnCancelClicked" />
                <Button Width="120" Margin="8,0,0,0" Style="{StaticResource PrimaryPillButton}" Content="Начать" Click="OnStartClicked" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
