<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PhotoShelf</AssemblyName>
    <StartupObject>PhotoShelf.Desktop.Program</StartupObject>
    <Product>PhotoShelf Ultra</Product>
    <Description>Fast local photo library for Windows</Description>
    <ApplicationIcon>Assets\PhotoShelf.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PhotoShelf.Application\PhotoShelf.Application.csproj" />
    <ProjectReference Include="..\PhotoShelf.Domain\PhotoShelf.Domain.csproj" />
    <ProjectReference Include="..\PhotoShelf.Infrastructure.Sqlite\PhotoShelf.Infrastructure.Sqlite.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>
  <ItemGroup>
    <None Include="RUNNING.txt" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Remove="Assets\PhotoShelf.ico;Assets\giraffe-icon.png" />
    <Resource Include="Assets\PhotoShelf.ico" />
    <Resource Include="Assets\giraffe-icon.png" />
    <None Include="Assets\giraffe-icon-source.png" />
  </ItemGroup>
</Project>
