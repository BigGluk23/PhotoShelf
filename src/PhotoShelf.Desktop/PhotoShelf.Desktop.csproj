<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PhotoShelf</AssemblyName>
    <StartupObject>PhotoShelf.Desktop.Program</StartupObject>
    <Product>PhotoShelf Ultra</Product>
    <Description>Fast local photo library for Windows</Description>
    <ApplicationIcon>Assets\PhotoShelf.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PhotoShelf.Application\PhotoShelf.Application.csproj" />
    <ProjectReference Include="..\PhotoShelf.Domain\PhotoShelf.Domain.csproj" />
    <ProjectReference Include="..\PhotoShelf.Infrastructure.Sqlite\PhotoShelf.Infrastructure.Sqlite.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="RUNNING.txt" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\docs\licenses\*" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Remove="Assets\PhotoShelf.ico;Assets\giraffe-icon.png" />
    <Resource Include="Assets\PhotoShelf.ico" />
    <Resource Include="Assets\giraffe-icon.png" />
    <None Include="Assets\giraffe-icon-source.png" />
    <EmbeddedResource Include="..\..\tests\Fixtures\Heif\quadrants.heic" LogicalName="PhotoShelf.SyntheticHeif.heic" />
    <None Include="..\..\artifacts\heif-codec\win-x64\**\*" Link="codecs\heif\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Target Name="RequireBundledHeifDecoder" BeforeTargets="PrepareForBuild"
          Condition="('$(OS)' == 'Windows_NT' or '$(PhotoShelfPublish)' == 'true') and (!Exists('$(MSBuildProjectDirectory)/../../artifacts/heif-codec/win-x64/PhotoShelf.HeifWorker.exe') or !Exists('$(MSBuildProjectDirectory)/../../artifacts/heif-codec/win-x64/heif.dll') or !Exists('$(MSBuildProjectDirectory)/../../artifacts/heif-codec/win-x64/libde265.dll'))">
    <Error Text="Build the bundled HEIF decoder first: pwsh tools/build-heif-codec.ps1" />
  </Target>
</Project>
