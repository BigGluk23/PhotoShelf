<Window x:Class="PhotoShelf.Desktop.PhotoViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PhotoShelf.Desktop"
        Title="PhotoShelf Ultra Viewer"
        Width="1160"
        Height="800"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#FF151619"
        Icon="pack://application:,,,/PhotoShelf;component/Assets/PhotoShelf.ico"
        KeyDown="OnKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="46" />
            <RowDefinition Height="104" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Border Background="#FF202126">
            <Grid Margin="14,0">
                <Button Content="←"
                        Width="38"
                        Height="30"
                        Style="{StaticResource DarkPillButton}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="OnPreviousClicked" />
                <TextBlock x:Name="TitleText"
                           Foreground="White"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <Button Content="→"
                        Width="38"
                        Height="30"
                        Style="{StaticResource DarkPillButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="OnNextClicked" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#FF111214">
            <local:PreviewImage x:Name="PhotoImage"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True" />

            <TextBlock Text="{Binding ElementName=PhotoImage, Path=Status}" Foreground="White" Background="#BB202126" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8" Padding="8" />
            <MediaElement x:Name="VideoPlayer"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          Stretch="Uniform"
                          Visibility="Collapsed"
                          MediaOpened="OnVideoOpened"
                          MediaEnded="OnVideoEnded" />

            <Grid Background="Transparent"
                  MouseLeftButtonDown="OnViewerSurfaceMouseLeftButtonDown" />
        </Grid>

        <Border x:Name="VideoControlsPanel" Grid.Row="2" Background="#FF202126" BorderBrush="#FF34363D" BorderThickness="0,1,0,0" Padding="12,7" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="58" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayPauseButton"
                        Width="72"
                        Height="30"
                        Content="Пауза"
                        Style="{StaticResource DarkPillButton}"
                        Click="OnPlayPauseClicked" />
                <TextBlock x:Name="VideoPositionText"
                           Grid.Column="1"
                           Foreground="#FFDDDDDD"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="0:00" />
                <Slider x:Name="VideoSeekSlider"
                        Grid.Column="2"
                        Minimum="0"
                        Maximum="1"
                        ValueChanged="OnVideoSeekChanged"
                        PreviewMouseDown="OnVideoSeekStarted"
                        PreviewMouseUp="OnVideoSeekFinished"
                        VerticalAlignment="Center" />
                <TextBlock x:Name="VideoDurationText"
                           Grid.Column="3"
                           Foreground="#FFDDDDDD"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="0:00" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#FF202126" BorderBrush="#FF34363D" BorderThickness="0,1,0,1" Padding="8">
            <ListBox x:Name="FilmstripList"
                     ItemsSource="{Binding FilmstripItems}"
                     SelectionChanged="OnFilmstripSelectionChanged"
                     SelectedIndex="5"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalContentAlignment="Center"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="3,0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chrome" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="14" Padding="3" Opacity="0.72">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#FFE8773A" />
                                            <Setter TargetName="Chrome" Property="Opacity" Value="1" />
                                            <Setter Property="Panel.ZIndex" Value="10" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ThumbCard" Width="{Binding Width}" Height="{Binding Height}" Background="#FF2D3036" CornerRadius="10" ClipToBounds="True">
                            <Grid>
                                <Image local:AsyncMediaImage.Path="{Binding Item.Path}" Stretch="UniformToFill" />
                                <TextBlock Text="{Binding Item.KindLabel}"
                                           Foreground="#FFEFEFEF"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCenter}" Value="True">
                                <Setter TargetName="ThumbCard" Property="Width" Value="122" />
                                <Setter TargetName="ThumbCard" Property="Height" Value="88" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="4" Background="#FF202126">
            <TextBlock x:Name="DetailText"
                       Foreground="#FFDDDDDD"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
