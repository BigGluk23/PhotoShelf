<Window x:Class="PhotoShelf.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PhotoShelf.Desktop"
        Title="Настройки PhotoShelf"
        Width="720"
        Height="720"
        MinWidth="620"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Loaded="OnSettingsLoaded"
        Background="#FFF7F4EF"
        Icon="pack://application:,,,/PhotoShelf;component/Assets/PhotoShelf.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Настройки" FontSize="24" FontWeight="SemiBold" Foreground="#FF242424" />
            <TextBlock Margin="0,6,0,0"
                       Text="Библиотека, расположение данных и обслуживание."
                       Foreground="#FF77706A"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,18" Background="White" CornerRadius="16" BorderBrush="#FFE6DDD2" BorderThickness="1" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18">
                <StackPanel>
                    <local:UpdatesPanel x:Name="UpdatesSection" />
                    <Separator Margin="0,18,0,14" />
                    <TextBlock Text="Библиотека" FontSize="16" FontWeight="SemiBold" />
                    <CheckBox x:Name="ShowVideosCheckBox" Margin="0,12,0,0" Content="Показывать видео" />
                    <CheckBox x:Name="IncludeSystemFoldersCheckBox" Margin="0,8,0,0" Content="Показывать и сканировать системные/скрытые папки" />

                    <TextBlock Margin="0,8,0,0"
                               Text="Если выключено, пропускаются Windows, Program Files, ProgramData, настоящий системный TEMP и элементы с атрибутами Hidden/System/Temporary. Обычные пользовательские папки с именами Cache или Temp сканируются. Корзина, карантин и служебные данные PhotoShelf исключены всегда."
                               Foreground="#FF77706A"
                               TextWrapping="Wrap" />

                    <Separator Margin="0,18,0,14" />

                    <TextBlock Text="Фоновая обработка" FontSize="16" FontWeight="SemiBold" />
                    <ComboBox x:Name="BackgroundLoadModeBox" Margin="0,10,0,8" SelectedIndex="1">
                        <ComboBoxItem Content="Тихий — меньше фоновой нагрузки" />
                        <ComboBoxItem Content="Сбалансированный" />
                        <ComboBoxItem Content="Максимальная скорость" />
                    </ComboBox>
                    <TextBlock Text="При прокрутке, просмотре и работе от батареи фон автоматически замедляется. Режим меняет паузы между чтениями, а не качество фото. Прогресс и пауза доступны в «Операциях»." TextWrapping="Wrap" Foreground="#FF77706A" />
                    <Separator Margin="0,18,0,14" />
                    <TextBlock Text="Каталог и кэш" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0" Text="Служебная папка:" Foreground="#FF77706A" />
                    <TextBox x:Name="CatalogPathBox" Margin="0,4,0,0" IsReadOnly="True" TextWrapping="NoWrap" />
                    <TextBlock x:Name="StorageWarningText" Margin="0,8,0,0" Foreground="#FF8C5A17" TextWrapping="Wrap" />
                    <TextBlock Margin="0,12,0,0" Text="Новые миниатюры и диагностика:" Foreground="#FF77706A" />
                    <TextBox x:Name="DerivedPathBox" Margin="0,4,0,0" IsReadOnly="True" />

                    <WrapPanel Margin="0,14,0,0">
                        <Button Width="150" Margin="0,0,10,8" Style="{StaticResource PillButton}" Content="Открыть каталог" Click="OnOpenCatalogClicked" />
                        <Button x:Name="ClearCacheButton" Width="180" Margin="0,0,10,8" Style="{StaticResource PillButton}" Content="Очистить миниатюры" Click="OnClearThumbnailCacheClicked" />
                        <Button Width="205" Margin="0,0,10,8" Style="{StaticResource PillButton}" Content="Экспорт для поддержки" Click="OnExportDiagnosticsClicked" />
                    </WrapPanel>

                    <TextBlock Margin="0,6,0,0"
                               Text="Очистка удаляет только созданные PhotoShelf файлы кэша v2; посторонние файлы, старый неизвестный кэш, база и журналы сохраняются. Новые превью появятся при следующем запросе. Экспорт для поддержки содержит только обезличенную сводку, без фото, путей и исходных журналов."
                               Foreground="#FF77706A"
                               TextWrapping="Wrap" />

                    <Separator Margin="0,18,0,14" />

                    <TextBlock Text="Карантин дублей" FontSize="16" FontWeight="SemiBold" />
                    <TextBox x:Name="QuarantinePathBox" Margin="0,8,0,0" IsReadOnly="True" Text="Папка ещё не выбрана" />
                    <Button x:Name="ChooseQuarantineButton" Width="210" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource PillButton}" Content="Выбрать папку карантина" Click="OnChooseQuarantineClicked" />
                    <TextBlock Margin="0,8,0,0"
                               Text="Карантин хранит полные оригиналы. Папку нужно выбрать явно; перед переносом будет показан план. Смена папки не перемещает прежний карантин и не сбрасывает историю отката. Даже локальные папки могут копироваться внешними программами синхронизации."
                               Foreground="#FF77706A"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SettingsStatusText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#FF77706A" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="110" Style="{StaticResource PillButton}" Content="Отмена" Click="OnCancelClicked" />
            <Button Width="120" Margin="8,0,0,0" Style="{StaticResource PrimaryPillButton}" Content="Сохранить" Click="OnSaveClicked" />
        </StackPanel>
    </Grid>
</Window>
