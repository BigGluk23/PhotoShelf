<Window x:Class="PhotoShelf.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки PhotoShelf"
        Width="720"
        Height="560"
        MinWidth="620"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="#FFF7F4EF"
        Icon="Assets/PhotoShelf.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Настройки" FontSize="24" FontWeight="SemiBold" Foreground="#FF242424" />
            <TextBlock Margin="0,6,0,0"
                       Text="Первые рабочие настройки. Позже сюда добавим декодеры, карту, RAW/HEIC и правила дублей."
                       Foreground="#FF77706A"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,18" Background="White" CornerRadius="16" BorderBrush="#FFE6DDD2" BorderThickness="1" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18">
                <StackPanel>
                    <TextBlock Text="Библиотека" FontSize="16" FontWeight="SemiBold" />
                    <CheckBox x:Name="ShowVideosCheckBox" Margin="0,12,0,0" Content="Показывать видео" />
                    <CheckBox x:Name="IncludeSystemFoldersCheckBox" Margin="0,8,0,0" Content="Показывать и сканировать системные/скрытые папки" />

                    <TextBlock Margin="0,8,0,0"
                               Text="Если системные папки выключены, PhotoShelf не будет тащить в библиотеку Windows, Program Files, временные папки и кэши."
                               Foreground="#FF77706A"
                               TextWrapping="Wrap" />

                    <Separator Margin="0,18,0,14" />

                    <TextBlock Text="Каталог и кэш" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0" Text="Служебная папка:" Foreground="#FF77706A" />
                    <TextBox x:Name="CatalogPathBox" Margin="0,4,0,0" IsReadOnly="True" TextWrapping="NoWrap" />

                    <WrapPanel Margin="0,14,0,0">
                        <Button Width="150" Margin="0,0,10,8" Style="{StaticResource PillButton}" Content="Открыть каталог" Click="OnOpenCatalogClicked" />
                        <Button Width="180" Margin="0,0,10,8" Style="{StaticResource PillButton}" Content="Очистить миниатюры" Click="OnClearThumbnailCacheClicked" />
                    </WrapPanel>

                    <TextBlock Margin="0,6,0,0"
                               Text="Очистка миниатюр безопасна: оригиналы не трогаются, превью создадутся заново при следующем просмотре."
                               Foreground="#FF77706A"
                               TextWrapping="Wrap" />

                    <Separator Margin="0,18,0,14" />

                    <TextBlock Text="Скоро здесь" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0"
                               Text="Следующие настройки: HEIC/RAW/видео-декодеры, размер кэша, правила исключений, карта, правила дублей и обслуживание базы."
                               Foreground="#FF77706A"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="110" Style="{StaticResource PillButton}" Content="Отмена" Click="OnCancelClicked" />
            <Button Width="120" Margin="8,0,0,0" Style="{StaticResource PrimaryPillButton}" Content="Сохранить" Click="OnSaveClicked" />
        </StackPanel>
    </Grid>
</Window>
