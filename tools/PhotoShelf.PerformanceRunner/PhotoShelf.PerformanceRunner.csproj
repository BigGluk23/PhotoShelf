<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PhotoShelfSourceRoot Condition="'$(PhotoShelfSourceRoot)' == ''">$(MSBuildThisFileDirectory)../..</PhotoShelfSourceRoot>
    <StartupObject>PhotoShelf.PerformanceRunner.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(PhotoShelfSourceRoot)/src/PhotoShelf.Desktop/PhotoShelf.Desktop.csproj" />
  </ItemGroup>
</Project>
